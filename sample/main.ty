namespace main

//use std::net::Network;
//use std::net::Socket;
//use std::net::Listener;
//use std::option::Some;
//use std::result::Ok;

struct Popcount {
  ar: [Int32],
}

impl Popcount {
  fn check(self, even: Int8) -> Int32 {
    let ch: ref chan<Int32> = chan<Int32>();
    let mut sent = 0;
    for x in self.ar {
      conc {
        printf("Try %d\r\n", x);
        let n = match (x & even) {
          x => 1
          _ => 0
        }
        ch.send(n);
      }
      sent += 1;
    }

    let mut count = 0;
    while sent > 0 {
      let Some(value) = ch.recv() else { break; }
      count += value;
      sent -= 1;
    }
    return count;
  }
}

fn handle_connection(socket: Socket) {
  let ch: ref chan<Int8> = chan<Int8>();
  socket.consume(ch);

  let p: Popcount = Popcount {
    ar: [1, 2, 4, 8, 16, 32, 64, 128],
  }

  while true {
    let Some(i) = ch.recv() else { break; }  // None = channel closed = EOF
    let n = p.check(i);
    printf("Result: %d\r\n", n);
  }
  socket.close();
}

fn main(net: Network) -> Int32 {
  let Ok(listener) = net.listen("0.0.0.0:8080") else {
    println("Listen failed\r\n");
    return 0;
  };
  println("Listening on :8080");

  let mut loop = true;
  while loop {
    let Ok(socket) = listener.accept() else { loop = false; };
    conc { handle_connection(socket); }
  }
  return 0;
}
