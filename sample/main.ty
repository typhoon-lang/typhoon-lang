namespace main

use std::net::Network;
use std::net::Socket;
use std::net::Listener;
use std::net::ReadSocket;
use std::net::WriteSocket;
use std::net::SocketHalves;
use std::option::Some;
use std::result::Ok;
use std::io::Stdout;
use std::buf::Buf;
// method calls (chunk.toStr(), data.length(), data.at(i)) — need
// Buf.toStr/Str.length/Str.at impls in buf.ty/str.ty (not held here).

struct Popcount {
  ar: [Int32],
}

impl Popcount {
  // Takes `self` by value (consuming). The caller must ensure it is not reused
  // after this call. Use `let mut p` if the checker should ignore liveness for p,
  // or restructure into a standalone function if p must survive multiple calls.
  fn check(self, even: Int32) -> Int32 {
    let out = Stdout{}
    // `ref chan` — shared channel handle; can be cloned into conc blocks freely.
    let ch: ref chan<Int32> = chan<Int32>();
    let mut sent = 0;
    for e in self.ar {
      // `e` is copy (Int32 element), `out` is ptr-exempt (Stdout), `ch` is ref-shared.
      // `even` is copy (Int32). No `mut` binding crosses this boundary — Isolation
      // Guard satisfied.
      conc {
        let x = e as Int64;
        out.printf("Try %d\r\n", x);
        let n = match (x & even) {
          x => 1
          _ => 0
        }
        ch.send(n);
      }
      sent += 1;
    }

    let mut count = 0;
    while sent > 0 {
      let Some(value) = ch.recv() else { break; }
      count += value;
      sent -= 1;
    }
    return count;
  }
}

fn handle_connection(socket: Socket) {
  let out = Stdout{}
  // socket.consume(ch) no longer exists — Socket__consume was deleted
  // (Phase 2, Task 2.1): it sent one channel op per BYTE, the opposite
  // of the chunk-based backpressure model (D4). split()/into_chan()
  // replaces it: the reader coroutine sends one Buf per CHUNK.
  // Confirmed against the real net.ty (SocketHalves { read, write }).
  let halves = socket.split();
  let read_sock = halves.read;
  let write_sock = halves.write;
  let ch: ref chan<Buf> = read_sock.into_chan(4096, 16);

  // `p` is declared `let mut` so the liveness checker does not track it as a
  // linear resource. This allows `p.check(...)` to be called on every loop
  // iteration without the checker seeing a use-after-move. `mut` is scoped to
  // this function and never escapes — no conc block captures it.
  let mut p = Popcount {
    ar: [1, 2, 4, 8, 16, 32, 64, 128],
  }

  while true {
    let Some(chunk) = ch.recv() else { break; }  // None = channel closed = EOF
    // Buf.toStr() consumes chunk, returns Str. Str.length()/Str.at() walk it.
    let data = chunk.toStr();
    let clen = data.length()
    let mut idx = 0 as Int64
    while idx < clen {
      let byte = data.at(idx)
      let n = p.check(byte as Int32) as Int64;
      out.printf("Result: %d\r\n", n);
      idx = idx + 1
    }
  }
  // Both halves are separate linear resources now (Task 2.5) — each needs
  // its own close, same "compiler inserts a drop at scope exit if not
  // explicitly closed" behavior as the original single Socket had.
  read_sock.close();
  write_sock.close();
}

fn main(net: Network) -> Int32 {
  let out = Stdout{}
  // `listener` is a linear resource (Listener). It lives for the duration of
  // main and is dropped at function exit (compiler-generated drop).
  let Ok(listener) = net.listen("0.0.0.0:8080") else {
    out.println("Listen failed\r\n");
    return 0;
  };
  out.println("Listening on :8080");

  while true {
    // `socket` is a fresh linear resource each iteration. It is consumed by the
    // `conc` capture — moved into the spawned coroutine, making it unavailable
    // in the loop body after the conc statement. Isolation Guard: `socket` is an
    // immutable `let` binding, so the capture is legal.
    let Ok(socket) = listener.accept() else { break; };
    conc { handle_connection(socket); }
  }
  return 0;
}
